<div class="details__attachment-preview">
    <div class="details__attachment-preview-bar">
        <button type="button" class="details__attachment-preview-action details__attachment-preview-back">
            <i class="fa fa-chevron-left"></i>{{res 'detAttReturn'}}
        </button>
        <button type="button" class="details__attachment-preview-action details__attachment-preview-download-btn">
            <i class="fa fa-download"></i>{{res 'detAttSave'}}
        </button>
        <button type="button" class="details__attachment-preview-action details__attachment-preview-action--danger details__attachment-preview-delete-btn">
            <i class="fa fa-trash-alt"></i>{{res 'detAttDelete'}}
        </button>
    </div>
    <div class="details__attachment-preview-data"></div>
    <i class="fa details__attachment-preview-icon"></i>
</div>
