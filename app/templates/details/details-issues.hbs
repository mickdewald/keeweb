{{#if hasPasswordIssues}}
    <div class="details__issues {{#if fadeIn}}fade-in{{/if}}">
        <div class="details__issues-icon">
            <i class="fa fa-exclamation-triangle details__issues-icon-warning"></i>
            <i class="fa fa-spinner spin details__issues-icon-spin"></i>
        </div>
        <div class="details__issues-body">
            {{#each passwordIssues as |issue|}}
            <p class="details__issues-line">
                {{#ifeq issue.type 'weak'}}{{res 'detIssueWeakPassword'}}{{/ifeq}}
                {{#ifeq issue.type 'poor'}}{{res 'detIssuePoorPassword'}}{{/ifeq}}
                {{#ifeq issue.type 'reused'}}{{#res 'detIssueReusedPassword'}}{{issue.count}}{{/res}}{{/ifeq}}
                {{#ifeq issue.type 'old'}}{{#res 'detIssueOldPassword'}}{{issue.years}}{{/res}}{{/ifeq}}
                {{#ifeq issue.type 'pwned'}}{{#res 'detIssuePwnedPassword'}}<a href="{{../hibpLink}}" rel="noreferrer noopener" target="_blank">Have I Been Pwned</a>{{/res}}{{/ifeq}}
                {{#ifeq issue.type 'error'}}{{res 'detIssuePasswordCheckError'}}{{/ifeq}}
            </p>
            {{/each}}
        </div>
        <div class="details__issues-close-btn" title="{{res 'detIssuesHideTooltip'}}">
            <i class="fa fa-times-circle"></i>
        </div>
    </div>
{{else}}
    <div></div>
{{/if}}
