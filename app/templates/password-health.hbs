<div class="pw-health">
    <div class="back-button">
        {{res 'retToApp'}} <i class="fa fa-arrow-circle-left back-button__post"></i>
    </div>
    <div class="pw-health__inner">
        <h1 class="pw-health__title"><i class="fa fa-exclamation-triangle"></i> {{res 'pwHealthTitle'}}</h1>
        {{#if ok}}
            <p class="pw-health__ok">{{res 'pwHealthOk'}}</p>
        {{else}}
            <p class="pw-health__summary">{{summary}}</p>
        {{/if}}

        {{#if weak.length}}
        <section class="pw-health__section">
            <h2>{{res 'pwHealthWeak'}} <span class="pw-health__count">{{weak.length}}</span></h2>
            {{#each weak as |item|}}
            <button type="button" class="pw-health__entry" data-id="{{item.id}}">
                <span class="pw-health__entry-title">{{#if item.title}}{{item.title}}{{else}}({{res 'noTitle'}}){{/if}}</span>
                <span class="pw-health__entry-meta">{{item.user}}{{#if item.fileName}} · {{item.fileName}}{{/if}}</span>
                <span class="pw-health__badge pw-health__badge--{{item.severity}}">{{#ifeq item.severity 'poor'}}{{res 'pwHealthPoor'}}{{else}}{{res 'pwHealthWeak'}}{{/ifeq}}</span>
            </button>
            {{/each}}
        </section>
        {{/if}}

        {{#if reused.length}}
        <section class="pw-health__section">
            <h2>{{res 'pwHealthReused'}} <span class="pw-health__count">{{reusedEntries}}</span></h2>
            {{#each reused as |group|}}
            <div class="pw-health__group">
                <div class="pw-health__group-label">{{group.label}}</div>
                {{#each group.entries as |item|}}
                <button type="button" class="pw-health__entry" data-id="{{item.id}}">
                    <span class="pw-health__entry-title">{{#if item.title}}{{item.title}}{{else}}({{res 'noTitle'}}){{/if}}</span>
                    <span class="pw-health__entry-meta">{{item.user}}{{#if item.fileName}} · {{item.fileName}}{{/if}}</span>
                </button>
                {{/each}}
            </div>
            {{/each}}
        </section>
        {{/if}}

        {{#if old.length}}
        <section class="pw-health__section">
            <h2>{{res 'pwHealthOld'}} <span class="pw-health__count">{{old.length}}</span></h2>
            <p class="pw-health__hint">{{oldHint}}</p>
            {{#each old as |item|}}
            <button type="button" class="pw-health__entry" data-id="{{item.id}}">
                <span class="pw-health__entry-title">{{#if item.title}}{{item.title}}{{else}}({{res 'noTitle'}}){{/if}}</span>
                <span class="pw-health__entry-meta">{{item.user}}{{#if item.updated}} · {{item.updated}}{{/if}}{{#if item.fileName}} · {{item.fileName}}{{/if}}</span>
            </button>
            {{/each}}
        </section>
        {{/if}}
    </div>
</div>
