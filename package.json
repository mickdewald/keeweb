  "scripts": {
    "start": "grunt",
    "lint": "grunt eslint",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider grunt test && npm run test:private-updater",
    "test:private-updater": "node --test test/desktop/*.test.js",
    "test:macos-deploy-target": "bash scripts/dev/test-build-macos-touchid-agent.sh && bash scripts/release/test-build-public-macos.sh && bash scripts/release/test-notary-openbao.sh",
    "build:public-macos": "bash scripts/release/build-public-macos.sh",
    "publish:public-macos": "node scripts/release/publish-public-release.js",
    "test:public-updater": "bash scripts/release/test-public-updater.sh",
    "build-beta": "grunt --beta && cp dist/index.html ../keeweb-beta/index.html && cd ../keeweb-beta && git add index.html && git commit -a -m 'beta' && git push origin master",
    "electron": "cross-env KEEWEB_IS_PORTABLE=0 ELECTRON_DISABLE_SECURITY_WARNINGS=1 KEEWEB_EMULATE_HARDWARE_ENCRYPTION=persistent KEEWEB_HTML_PATH=http://localhost:8085 electron desktop --no-sandbox",
    "dev": "grunt dev",
    "dev-legacy": "cross-env NODE_OPTIONS='--openssl-legacy-provider' grunt dev",
    "dev-desktop-macos": "grunt dev-desktop-darwin --skip-sign",
    "dev-desktop-macos-signed": "grunt dev-desktop-darwin-signed",
    "dev-desktop-windows": "grunt dev-desktop-win32 --skip-sign",
    "dev-desktop-linux": "grunt dev-desktop-linux --skip-sign",
    "babel-helpers": "node scripts/generate-babel-helpers.js app/lib/babel-helpers.js",
    "set-legacy": "export NODE_OPTIONS=--openssl-legacy-provider"
  },
  "author": {
    "name": "Antelle",
    "email": "antelle.net@gmail.com",
    "url": "https://antelle.net"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "license": "MIT",
  "readme": "README.md",
  "browserslist": [
    "last 2 Firefox versions",
    "last 2 Chrome versions",
    "last 2 Safari version",
    "last 2 iOS versions",
    "last 2 Edge versions",
    "last 1 Opera version",
    "last 1 ChromeAndroid version",
    "Electron > 6.0.1"
  ],
  "allowScripts": {
    "electron@43.4.0": true
  }
}
